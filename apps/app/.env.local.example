# Self-hosted Den control plane (dev): point the OpenWork desktop/web client at
# the local den-api instead of the official OpenWork Cloud (app.openworklabs.com).
#
# Copy this file to `.env.local` (git-ignored) — Vite injects VITE_* keys into
# `import.meta.env` at dev/build time. See BUILD_DEN_BASE_URL in
# apps/app/src/app/lib/den.ts. For the Electron shell's default bootstrap URL,
# set OPENWORK_DEN_BASE_URL (apps/desktop/electron/main.mjs) to the same value.
VITE_DEN_BASE_URL=http://127.0.0.1:8790

# Optional: force the sign-in gate for web deployments (defaults to off).
# VITE_DEN_REQUIRE_SIGNIN=1
